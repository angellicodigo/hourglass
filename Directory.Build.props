<Project>
  <PropertyGroup>
    <Version>1.15.56.0</Version>
    <DisplayVersion>$([System.Text.RegularExpressions.Regex]::Replace($(Version), '\.0$', ''))</DisplayVersion>
    <CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
</Project>
